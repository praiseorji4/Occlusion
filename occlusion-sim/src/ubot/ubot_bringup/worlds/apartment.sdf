<?xml version="1.0" ?>
<!--
  Indoor apartment/corridor world for the Inspection Robot.

  The building is the "Apartment" model from Gazebo Fuel (OpenRobotics, CC-BY 4.0),
  vendored into ubot_bringup/models/apartment so the sim runs offline and identically
  on every machine. (The Fuel copy alone renders untextured: its COLLADA references
  the .jpg textures by bare filename while Fuel stores them in materials/textures,
  so the vendored copy also keeps a duplicate of each texture beside the .dae.)

  Layout: two halls roughly 7 x 20 m joined by short passages.
  Open floor for spawning: (5.0, 0) and (-5.0, 0), ~4 m clearance.
  The halls run along Y, so spawn with yaw = 1.5708 to face down a corridor.
-->
<sdf version='1.10'>
  <world name='apartment'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::AirPressure' filename='gz-sim-air-pressure-system'/>
    <plugin name='gz::sim::systems::Altimeter' filename='gz-sim-altimeter-system'/>
    <plugin name='gz::sim::systems::Imu' filename='gz-sim-imu-system'/>
    <plugin name='gz::sim::systems::Magnetometer' filename='gz-sim-magnetometer-system'/>
    <plugin name='gz::sim::systems::ForceTorque' filename='gz-sim-forcetorque-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <!-- Indoor scene: brighter ambient, because the building has a roof and the
         directional "sun" alone leaves the interior almost black. -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.4 0.45 0.5 1</background>
      <shadows>true</shadows>
    </scene>

    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Interior fill lights, one per hall -->
    <light type='point' name='hall_light_right'>
      <pose>5 0 2.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type='point' name='hall_light_left'>
      <pose>-5 0 2.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.75 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.4</constant>
        <linear>0.05</linear>
        <quadratic>0.005</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Ground plane sits 2 cm below the building floor to avoid z-fighting. -->
    <model name='ground_plane'>
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://apartment</uri>
      <name>apartment</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
