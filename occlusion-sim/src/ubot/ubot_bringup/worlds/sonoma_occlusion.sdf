<?xml version="1.0" ?>
<sdf version='1.8'>
  <world name='sensors'>
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.8 0.8 0.8 1.0</background>
      <sky></sky>
    </scene>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/openrobotics/models/Sonoma Raceway</uri>
    </include>

    <include>
      <name>background_apartment</name>
      <pose>263.0 -96.0 5.0 0 0 0.8</pose>
      <uri>https://fuel.gazebosim.org/1.0/chapulina/models/Apartment</uri>
    </include>

    <!-- Verified Pickup Truck Location -->
    <include>
      <name>pickup_truck</name>
      <pose>268.04 -132.38 3.40 0 0 2.40</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
    </include>

    <!-- Verified Pickup Truck Location -->
    <include>
      <name>SUV</name>
      <pose>246.55 -115.74 4.24 0 0 2.40</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
    </include>

    Verified Hatchback Location
    <include>
      <name>Ambulance</name>
      <pose>261.69 -117.41 3.27 0 0 -2.28</pose>
      <uri>https://fuel.gazebosim.org/1.0/chapulina/models/Ambulance</uri>
    </include>

    <!-- Verified Hatchback Location -->
    <include>
      <name>Hatchback</name>
      <pose>272.82 -128.64 3.40 0 0 2.39</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRoboticsTest/models/Hatchback copy</uri>
    </include>

      <!-- Verified Hatchback Location
    <include>
      <name>red_hatchback</name>
      <pose>273.25 -128.95 3.72 0 0 2.39</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback red copy</uri>
    </include> -->


    <!-- Static Heavy Occlusion (Behind Hatchback) -->
    <include>
      <name>heavily_occluded_pedestrian</name>
      <pose>270.5 -128 4.1 0 0 0.8</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Male visitor</uri>
    </include>

    <!-- Verified Visible Pedestrian Location -->
    <include>
      <name>visible_pedestrian</name>
      <pose>257.29 -115.23 3.6 0 0 -2.17</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Nurse</uri>
    </include>

    <!-- Verified Visible Pedestrian Location -->
    <include>
      <name>2nd_visible_pedestrian</name>
      <pose>258.61 -118.01 3.8 0 0 -2.17</pose>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
    </include>
    
    
    <!-- Dynamic Actor Traversing the Truck Hood at Z=3.40 -->
    <actor name="crossing_pedestrian">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/chapulina/models/Walking actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/chapulina/models/Walking actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0.0</time>
            <pose>265.0 -131.0 4.2 0 0 -0.7</pose>
          </waypoint>
          <waypoint>
            <time>4.0</time>
            <pose>266.5 -129.5 4.2 0 0 -0.7</pose>
          </waypoint>
          <waypoint>
            <time>6.0</time>
            <pose>267.5 -128.5 4.2 0 0 -0.7</pose>
          </waypoint>
          <waypoint>
            <time>8.0</time>
            <pose>267.5 -128.5 4.2 0 0 2.44</pose>
          </waypoint>
          <waypoint>
            <time>14.0</time>
            <pose>265.0 -131.0 4.2 0 0 2.44</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>