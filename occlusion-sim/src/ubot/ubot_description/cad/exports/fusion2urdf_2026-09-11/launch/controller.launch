<launch>

<rosparam file="$(find Inspection_Robot_Fixed_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="Inspection_Robot_Fixed" args="wheel_fl_joint_position_controller wheel_fr_joint_position_controller wheel_rl_joint_position_controller wheel_rr_joint_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/Inspection_Robot_Fixed/joint_states"/>
</node>

</launch>