<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Luxonis OAK-D Lite depth camera in the front CamCase.

    camera_link sits at the centre of the RGB lens on the front face, X pointing out of
    the lens. Mesh: simplified 91 x 28 x 17.5 mm body with the three lenses, exported in
    Fusion world coordinates.

    TILT. The CamCase pocket tilts the camera 4.09 deg (0.0714 rad) DOWN in CAD. The
    `pitch` argument adds a correction measured on the real robot, POSITIVE = looking UP
    (calibrate_pose.py measures it against the ground plane), so the net tilt is
    cad_tilt - pitch and pitch=0 reproduces the CAD geometry exactly. Getting this wrong
    puts every camera-derived obstacle at the wrong height, which is why depth_to_scan
    reads the transform from TF rather than assuming it.
  -->
  <xacro:property name="camera_mass" value="0.061" />    <!-- OAK-D Lite datasheet -->
  <xacro:property name="camera_width" value="0.091" />
  <xacro:property name="camera_length" value="0.0175" />  <!-- depth, along X -->
  <xacro:property name="camera_height" value="0.028" />

  <xacro:property name="camera_x" value="0.167769" />
  <xacro:property name="camera_y" value="0.0" />
  <xacro:property name="camera_z" value="0.085654" />
  <xacro:property name="camera_cad_tilt" value="0.0714" />   <!-- rad, positive = looking down -->

  <!-- Mesh position in the exported (Fusion world) frame; the visual origin below is the
       inverse of the joint transform, computed symbolically because the tilt is variable. -->
  <xacro:property name="camera_mesh_x" value="0.330149" />
  <xacro:property name="camera_mesh_z" value="0.085654" />

  <xacro:macro name="ubot_camera" params="prefix pitch:=0">

    <!-- net tilt, positive = down -->
    <xacro:property name="tilt" value="${camera_cad_tilt - pitch}" />

    <!--CAMERA_LINK (OAK-D Lite body)-->
    <link name="${prefix}camera_link">
      <visual>
        <!-- inverse of the joint transform, so the world-frame mesh lands in place -->
        <origin xyz="${-camera_mesh_x*cos(tilt) + camera_mesh_z*sin(tilt)} 0 ${-camera_mesh_x*sin(tilt) - camera_mesh_z*cos(tilt)}"
                rpy="0 ${-tilt} 0"/>
        <geometry>
          <mesh filename="file://$(find ubot_description)/meshes/inspection/oakd_lite.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual>

      <!-- No collision shape: the OAK-D sits inside the chassis collision box, so one here
           would be unreachable. Add one if the camera is ever mounted proud of the body. -->

      <inertial>
        <origin xyz="${-camera_length/2} 0 0" rpy="0 0 0"/>
        <mass value="${camera_mass}"/>
        <inertia ixx="0.000046" ixy="0.0" ixz="0.0"
                 iyy="0.000006" iyz="0.0"
                 izz="0.000044"/>
      </inertial>
    </link>


    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}camera_link"/>
      <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 ${tilt} 0"/>
    </joint>

    <!-- WHICH FRAME IS WHICH, because getting this wrong rotates every
         camera-derived obstacle by 90 degrees and still looks plausible:

           camera_link           body frame:    X FORWARD, Y left, Z up
           camera_depth_frame    body-aligned, identical to camera_link
           camera_rgb_frame      OPTICAL:       X right, Y down, Z FORWARD
           camera_optical_frame  OPTICAL, same as camera_rgb_frame

         Images and point clouds use the OPTICAL convention, so anything that
         projects pixels into 3D must be stamped camera_rgb_frame or
         camera_optical_frame, never camera_depth_frame. -->

    <!-- CAMERA_DEPTH_FRAME: kept for compatibility. NOT an optical frame
         despite its old comment: it is aligned with camera_link. -->
    <link name="${prefix}camera_depth_frame"/>

    <joint name="${prefix}camera_depth_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_depth_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- CAMERA_RGB_FRAME: the optical frame. X right, Y down, Z forward. -->
    <link name="${prefix}camera_rgb_frame"/>

    <joint name="${prefix}camera_rgb_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_rgb_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- CAMERA_OPTICAL_FRAME: what Gazebo stamps its images and clouds with.
         Was parented to camera_depth_frame with no rotation, which made it
         body-aligned and its name a lie; it is now a real optical frame. -->
    <link name="${prefix}camera_optical_frame"/>

    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

  </xacro:macro>
</robot>
