<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.1415926535897931" />
  
  <!-- Camera Physical Properties -->
  <xacro:property name="camera_mass" value="0.072" />  <!-- Intel RealSense D435 ~72 g -->
  <xacro:property name="camera_width" value="0.090" />  <!-- Typical depth camera length -->
  <xacro:property name="camera_length" value="0.025" />
  <xacro:property name="camera_height" value="0.025" />
  
  <!-- Center of Mass -->
  <xacro:property name="com_x" value="0.0" />
  <xacro:property name="com_y" value="0.0" /> 
  <xacro:property name="com_z" value="0.0" /> 
  
  <!-- Camera Mounting Position (relative to base_link) -->
  <xacro:property name="camera_x" value="${base_length/2}" /> 
  <xacro:property name="camera_y" value="0.0" /> 
  <xacro:property name="camera_z" value="0.162618" /> 

  <xacro:macro name="ubot_camera" params="prefix">
    
    <!--CAMERA_LINK (Main camera body)-->
    <link name="${prefix}camera_link">
      <visual>
        <geometry>
            <box size="${camera_length} ${camera_width} ${camera_height}"/>
        </geometry>
        <origin xyz="${-camera_length/2} 0 0" rpy="0 0 0"/>  
        <material name="camera_white">
          <color rgba="0.9 0.9 0.9 1"/>
        </material>
      </visual>
      <!-- <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
        <geometry>
          <mesh filename="file://$(find ubot_description)/meshes/camera.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="camera_black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual> -->

      <collision>
        <geometry>
            <box size="${camera_length} ${camera_width} ${camera_height}"/>
        </geometry>
        <origin xyz="${-camera_length/2} 0 0" rpy="0 0 0"/> 
      </collision>

      <inertial>
        <origin xyz="${com_x} ${com_y} ${com_z}" rpy="0 0 0"/>
        <mass value="${camera_mass}"/>
        <inertia ixx="${(1/12) * camera_mass * ((camera_width * camera_width) + (camera_height * camera_height))}"  
                 ixy="0.0"  ixz="0.0"  
                 iyy="${(1/12) * camera_mass * ((camera_length * camera_length) + (camera_height * camera_height))}"  
                 iyz="0.0" 
                 izz="${(1/12) * camera_mass * ((camera_length * camera_length) + (camera_width * camera_width))}"/>
      </inertial>
    </link>


    <joint name="${prefix}camera_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}camera_link"/>
      <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
    </joint>

    <!-- CAMERA_DEPTH_FRAME (Optical frame for depth)
         This follows ROS REP-103 conventions X is right, Y is down, Z is forward -->
    <link name="${prefix}camera_depth_frame"/>
    
    <joint name="${prefix}camera_depth_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_depth_frame"/>
      <!-- Rotate to optical frame X right, Y down, Z forward -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- CAMERA_RGB_FRAME (Optical frame for RGB) Typically aligned with depth frame-->
    <link name="${prefix}camera_rgb_frame"/>
    
    <joint name="${prefix}camera_rgb_joint" type="fixed">
      <parent link="${prefix}camera_link"/>
      <child link="${prefix}camera_rgb_frame"/>
      <!-- Same orientation as depth frame -->
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- CAMERA_OPTICAL_FRAME (Alias for compatibility) -->
    <link name="${prefix}camera_optical_frame"/>
    
    <joint name="${prefix}camera_optical_joint" type="fixed">
      <parent link="${prefix}camera_depth_frame"/>
      <child link="${prefix}camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>

